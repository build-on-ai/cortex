# Cortex — Environment Variables

# Ollama
# Cortex runs on the host, so localhost reaches a stock Ollama install.
# In a container this fails: Ollama listens on 127.0.0.1 only, so neither
# localhost nor host.docker.internal reaches it. Use network_mode: host.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b          # or gemma4:26b, gemma4:31b, etc.

# Agent
AGENT_NAME=cortex

# Consciousness Server (optional — agent works without it)
# CS_URL=http://localhost:<port>

# CS request signing. CS answers 401 to unsigned requests, so this is
# required whenever CS_URL is set. Point it at an UNENCRYPTED OpenSSH
# ed25519 private key to sign every CS request with X-Agent-Id /
# X-Timestamp / X-Nonce / X-Signature headers. The protocol lives in
# consciousness-server, docs/SIGNING-PROTOCOL.md. The matching public key must
# be registered on the key-server as keys/agents/<AGENT_NAME>.pub —
# X-Agent-Id is taken from AGENT_NAME. A set-but-unreadable/wrong-type
# key is a hard startup error (no silent fallback to unsigned).
# Generate: ssh-keygen -t ed25519 -N '' -f ~/.ssh/ecosystem-cortex
# CS_SIGNING_KEY=~/.ssh/ecosystem-cortex

# Anthropic (optional)
# USE_ANTHROPIC=true makes Anthropic the PRIMARY model (replaces Ollama
# for chat) — it is not a fallback switch.
# Fallback-on-Ollama-failure is separate and requires BOTH
# ANTHROPIC_API_KEY and CORTEX_FALLBACK_ANTHROPIC=1; when enabled, the
# full message list (tool output included) is uploaded to
# api.anthropic.com on Ollama connection errors (each upload WARN-logged).
# ANTHROPIC_API_KEY=sk-ant-...
# USE_ANTHROPIC=false
# CORTEX_FALLBACK_ANTHROPIC=0

# Web UI
WEB_PORT=8080
