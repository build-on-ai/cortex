venv/
__pycache__/
*.pyc
.env
*.log

# Other environment files — the documented template stays public.
**/.env
**/.env.*
!**/.env.example
**/.envrc

# Private keys, certificates and credential bundles.
**/*.pem
**/*.key
**/id_rsa*
**/*.p12
**/*.pfx

# Local exports and runtime stores.
**/*.jsonl
**/*.db
**/*.rdb

# Test and build caches.
**/.pytest_cache/
**/.venv/
